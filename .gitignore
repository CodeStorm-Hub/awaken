# -----------------------------------------------------------------------------
# Flutter & Dart - General
# -----------------------------------------------------------------------------
# Dart tooling and dependencies
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Build artifacts
build/
coverage/

# Avoid committing generated JavaScript files if targeting web
*.dart.js
*.info.json      # Produced by the --dump-info flag
*.js             # Generated by dart2js
*.js_
*.js.deps
*.js.map

# Symbolication and debug symbols
*.symbols

# -----------------------------------------------------------------------------
# Environment Variables & Secrets
# -----------------------------------------------------------------------------
# Ignore local environment config containing API keys / secrets
.env
.env.*
# Exclude the example env file so a template remains in source control
!.env.example

# -----------------------------------------------------------------------------
# Platform Specifics
# -----------------------------------------------------------------------------
# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/src/main/java/     # Used when Java folder is empty / Kotlin is used
*.keystore
*.jks
*.apk
*.aab

# iOS & macOS
**/xcuserdata/
**/*.mode1v3
**/*.mode2v3
**/*.moved-aside
**/*.pbxuser
**/*.perspectivev3
**/DerivedData/
**/Pods/
**/.symlinks/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
macos/Flutter/ephemeral/

# Linux
linux/flutter/ephemeral/

# Windows
windows/flutter/ephemeral/
*.suo
*.user
*.userosscache
*.sln.docstates
x64/
x86/
*.[Cc]ache
!*.[Cc]ache/

# -----------------------------------------------------------------------------
# IDEs & Editors
# -----------------------------------------------------------------------------
# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# VS Code (Visual Studio Code)
.vscode/
# Note: Un-comment the line below if you want to share debug launch configurations
# !.vscode/launch.json

# Local history / backups
.history/
*~

# -----------------------------------------------------------------------------
# OS & System Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Project specific ignores
# -----------------------------------------------------------------------------
.remember/
