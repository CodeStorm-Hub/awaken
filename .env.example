# Supabase (session backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth (from android/app/google-services.json — Android-only)
# GOOGLE_ANDROID_CLIENT_ID: client_type 1 (package + SHA-1 binding)
GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_ID: client_type 3 (Supabase Google provider — not a web app)
GOOGLE_OAUTH_CLIENT_ID=
